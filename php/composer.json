        "advice",
        "random advice api",
        "advice generator",
        "get random advice",
        "random advice quotes",
        "random tips generator"
    ],
    "homepage": "https://apiverve.com/marketplace/advice?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/advice",
        "source": "https://github.com/apiverve/advice-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
